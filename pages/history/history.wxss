.picker-value {
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d8dfd2;
  border-radius: 14rpx;
  background: #ffffff;
  color: #152018;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.empty-card {
  border-style: dashed;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-head .section-title {
  margin-bottom: 0;
}

.delete-button {
  min-height: 64rpx;
  padding: 0 22rpx;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  background: #fff7f7;
  color: #dc2626;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.record-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.record-item {
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f7f8f3;
}

.record-label {
  display: block;
  color: #697282;
  font-size: 24rpx;
}

.record-value {
  display: block;
  margin-top: 6rpx;
  color: #152018;
  font-size: 28rpx;
  font-weight: 750;
}
